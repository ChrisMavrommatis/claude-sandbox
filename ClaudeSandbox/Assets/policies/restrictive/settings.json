{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(chmod 777 *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install -g *)",
      "Bash(apt-get install *)",
      "Bash(apt install *)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "deb.debian.org",
        "security.debian.org",
        "*.anthropic.com",
        "api.anthropic.com",
        "github.com",
        "*.github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
